# macOS configs
{{- if ne .chezmoi.os "darwin" }}
Library/
{{- end }}

# Windows configs 
{{- if ne .chezmoi.os "windows" }}
AppData/
{{- end }}

# common things to ignore
**/.DS_Store
**/.AppleDouble
**/Thumbs.db
**/node_modules/
**/README.md
**/LICENSE*
**/COPYING*
**/NOTICE*
**/AUTHORS*

# Application specific configs
{{- if not (get .machine "shared_user" | default false) }}
.local/bin/enter-personal
.local/bin/wrappers/tmux
{{- end }}

{{- if (not (lookPath "bash"))}}
.config/bash
.bashrc
.bash_profile
{{- end}}

{{- if (not (lookPath "evolution")) }}
.config/evolution
{{- end }}

{{- if (not (lookPath "fish"))}}
.config/fish
{{- end}}

# only apply fontconfig to linux
{{- if (not (and (lookPath "fc") (eq .machine.headless false) (or (eq .chezmoi.os "linux") (eq .machine.osid "termux"))))}}
.config/fontconfig
{{- end}}

{{- if (not (lookPath "ghostty"))}}
.config/ghostty
{{- end}}

{{- if (not (lookPath "nvim"))}}
.config/nvim
{{- end}}

{{- if (not (lookPath "starship"))}}
.config/starship.toml
{{- end}}

{{- if (not (lookPath "tmux"))}}
.config/tmux
{{- end}}

{{- if (not (lookPath "vlc"))}}
.config/vlc
{{- end}}

{{- if (not (lookPath "yazi"))}}
.config/yazi
{{- end}}

{{- if (not (lookPath "zellij"))}}
.config/zellij
{{- end}}

