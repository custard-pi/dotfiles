# .bash_profile

# Get the aliases and functions
if [ -f "${PERSONAL_ENV_HOME:-$HOME}/.bashrc" ]; then
    . "${PERSONAL_ENV_HOME:-$HOME}/.bashrc"
fi

# User specific environment and startup programs
if [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/bash/profile" ]; then
  for profile in "${XDG_CONFIG_HOME:-$HOME/.config}"/bash/profile/*.sh; do
    if [ -f "$profile" ]; then
      . "$profile"
    fi
  done
fi
unset profile
