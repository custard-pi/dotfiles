# vi: ft=config
# Ghostty keybindings override
# --- Gnome terminal ---
# find
keybind = ctrl+shift+f=start_search
keybind = ctrl+shift+g=navigate_search:next
keybind = ctrl+shift+h=navigate_search:previous
keybind = ctrl+shift+j=end_search
# tab navigation
keybind = ctrl+shift+page_up=move_tab:-1
keybind = ctrl+shift+page_down=move_tab:1
# alt + digit navigation
keybind = performable:alt+digit_1=goto_tab:1
keybind = performable:alt+digit_2=goto_tab:2
keybind = performable:alt+digit_3=goto_tab:3
keybind = performable:alt+digit_4=goto_tab:4
keybind = performable:alt+digit_5=goto_tab:5
keybind = performable:alt+digit_6=goto_tab:6
keybind = performable:alt+digit_7=goto_tab:7
keybind = performable:alt+digit_8=goto_tab:8
keybind = performable:alt+digit_9=goto_tab:9
keybind = performable:alt+digit_0=last_tab


# intuitive splitting
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+backslash=new_split:right
# split navigation
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+l=goto_split:right
keybind = ctrl+alt+k=goto_split:up

# --- Smart Copy ---
# copy if there is selection, elsewise send Ctrl+C（SIGINT）
keybind = performable:ctrl+c=copy_to_clipboard:mixed
# copy hovered URL
keybind = performable:ctrl+shift+y=copy_url_to_clipboard
